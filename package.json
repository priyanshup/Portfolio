{
  "name": "priyanshu-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://priyanshup.github.io/Portfolio/",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify": "node scripts/check-resume.js && node scripts/check-content.js && npm run lint",
    "smoke": "node scripts/smoke-test.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "copy": "node scripts/copy-check.mjs",
    "predeploy": "npm run verify && npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/zalando-sans-expanded": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "vite": "^8.3.5"
  }
}
